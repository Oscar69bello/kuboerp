@model Proveedor
@{
    ViewData["Title"] = Model.Nombre;
    ViewData["Seccion"] = "Compras · Proveedores";
    var ordenes = (List<OrdenCompra>)ViewBag.Ordenes;
    var cotizaciones = (List<Cotizacion>)ViewBag.Cotizaciones;
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2>Datos del proveedor</h2>
            <div class="dato"><span>NIT</span><b class="codigo">@Model.Nit</b></div>
            <div class="dato"><span>Correo</span><span>@Model.Correo</span></div>
            <div class="dato"><span>Teléfono</span><span>@Model.Telefono</span></div>
            <div class="dato"><span>Estado</span>@Ui.Estado(Model.Estado)</div>
            <div class="dato"><span>Presupuesto disponible</span><b class="total">@Ui.Pesos(Model.Presupuesto)</b></div>
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i> Editar</a>
                @if (Model.Estado == EstadosProveedor.Activo)
                {
                    <a asp-controller="Ordenes" asp-action="Crear" asp-route-proveedorId="@Model.Id" class="btn btn-kubo btn-sm"><i class="bi bi-cart-plus"></i> Nueva orden</a>
                }
                else
                {
                    <form asp-action="Reactivar" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-counterclockwise"></i> Reactivar</button></form>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="tarjeta mb-3">
            <h2>Órdenes de compra <small>@ordenes.Count</small></h2>
            <table class="tabla">
                <thead><tr><th>Orden</th><th>Fecha</th><th class="num">Monto</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var o in ordenes)
                    {
                        <tr><td><a class="codigo" asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@o.Id">@o.Codigo</a></td><td>@Ui.Fecha(o.Fecha)</td><td class="num">@Ui.Pesos(o.Monto)</td><td>@Ui.EstadoOrden(o.Estado)</td></tr>
                    }
                </tbody>
            </table>
            @if (ordenes.Count == 0) { <div class="vacio">Sin órdenes de compra</div> }
        </div>
        <div class="tarjeta">
            <h2>Cotizaciones <small>@cotizaciones.Count</small></h2>
            <table class="tabla">
                <thead><tr><th>Cotización</th><th>Solicitud</th><th class="num">Monto</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var c in cotizaciones)
                    {
                        <tr><td class="codigo">@c.Codigo</td><td><a asp-controller="Cotizaciones" asp-action="Solicitud" asp-route-id="@c.SolicitudId">@c.Solicitud?.Descripcion</a></td><td class="num">@Ui.Pesos(c.Monto)</td><td>@Ui.Estado(c.Estado)</td></tr>
                    }
                </tbody>
            </table>
            @if (cotizaciones.Count == 0) { <div class="vacio">Sin cotizaciones</div> }
        </div>
    </div>
</div>

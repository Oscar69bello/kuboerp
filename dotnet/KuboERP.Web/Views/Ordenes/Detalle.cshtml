@model OrdenCompra
@{
    ViewData["Title"] = "Orden " + Model.Codigo;
    ViewData["Seccion"] = "Compras · Órdenes de compra";
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="tarjeta mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="mb-0">@Model.Proveedor?.Nombre <small>NIT @Model.Proveedor?.Nit</small></h2>
                @Ui.EstadoOrden(Model.Estado)
            </div>
            <table class="tabla">
                <thead><tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Precio unitario</th><th class="num">Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Lineas)
                    {
                        <tr>
                            <td><span class="codigo">@l.Producto?.Codigo</span> <a asp-controller="Inventario" asp-action="Detalle" asp-route-id="@l.ProductoId">@l.Producto?.Nombre</a></td>
                            <td class="num">@l.Cantidad</td>
                            <td class="num">@Ui.Pesos(l.PrecioUnitario)</td>
                            <td class="num">@Ui.Pesos(l.Subtotal)</td>
                        </tr>
                    }
                    <tr><td colspan="3" class="num fw-semibold">Total</td><td class="num total">@Ui.Pesos(Model.Monto)</td></tr>
                </tbody>
            </table>
            @if (!string.IsNullOrEmpty(Model.Justificacion))
            {
                <div class="alert alert-secondary small mt-3 mb-0"><b>Justificación de la cancelación:</b> @Model.Justificacion</div>
            }
        </div>
        <div class="tarjeta">
            <h2><i class="bi bi-shield-check"></i> Auditoría de estados</h2>
            <ul class="linea-tiempo">
                @foreach (var a in Model.Auditoria.OrderBy(a => a.Fecha).ThenBy(a => a.Id))
                {
                    <li>
                        <b>@(string.IsNullOrEmpty(a.EstadoAnterior) ? "Creación" : a.EstadoAnterior + " → " + a.EstadoNuevo)</b> · @a.Detalle
                        <div class="text-secondary small">@Ui.FechaHora(a.Fecha)</div>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2>Acciones</h2>
            <div class="dato"><span>Fecha</span><span>@Ui.Fecha(Model.Fecha)</span></div>
            <div class="dato"><span>Presupuesto del proveedor</span><b>@Ui.Pesos(Model.Proveedor!.Presupuesto)</b></div>
            <div class="d-grid gap-2 mt-3">
                @if (Model.Estado == EstadosOrden.Pendiente)
                {
                    <form asp-action="Aprobar" asp-route-id="@Model.Id" method="post" class="d-grid">
                        <button class="btn btn-kubo"><i class="bi bi-check2-circle"></i> Aprobar orden</button>
                    </form>
                }
                @if (Model.Estado == EstadosOrden.Aprobada)
                {
                    <form asp-action="Recibir" asp-route-id="@Model.Id" method="post" class="d-grid">
                        <button class="btn btn-success"><i class="bi bi-box-arrow-in-down"></i> Registrar recepción de mercancía</button>
                    </form>
                }
                @if (EstadosOrden.Activos.Contains(Model.Estado))
                {
                    <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post">
                        <label class="form-label mt-2">Justificación para cancelar</label>
                        <textarea name="justificacion" rows="2" class="form-control mb-2" placeholder="Obligatoria"></textarea>
                        <button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle"></i> Cancelar orden</button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-link"><i class="bi bi-arrow-left"></i> Todas las órdenes</a>
            </div>
        </div>
    </div>
</div>

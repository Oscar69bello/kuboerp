@model List<MovimientoInventario>
@{
    ViewData["Title"] = "Kárdex de inventario";
    ViewData["Seccion"] = "Logística y almacén · Inventario";
}

<div class="tarjeta">
    <div class="d-flex justify-content-between mb-3">
        <h2 class="mb-0">Últimos 100 movimientos</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver al inventario</a>
    </div>
    <table class="tabla">
        <thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th class="num">Cantidad</th><th class="num">Saldo</th><th>Detalle</th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@Ui.FechaHora(m.Fecha)</td>
                    <td><span class="codigo">@m.Producto?.Codigo</span> <a asp-action="Detalle" asp-route-id="@m.ProductoId">@m.Producto?.Nombre</a></td>
                    <td>@Ui.Movimiento(m.Tipo)</td>
                    <td class="num @(m.Tipo == "ENTRADA" ? "text-success" : "text-danger")">@(m.Tipo == "ENTRADA" ? "+" : "−")@m.Cantidad</td>
                    <td class="num fw-semibold">@m.StockResultante</td>
                    <td>@m.Detalle</td>
                </tr>
            }
        </tbody>
    </table>
</div>

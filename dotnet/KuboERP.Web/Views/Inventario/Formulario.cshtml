@model Producto
@{
    bool nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo producto" : "Editar producto";
    ViewData["Seccion"] = "Logística y almacén · Inventario";
}

<div class="tarjeta" style="max-width:760px">
    <form method="post" asp-action="@(nuevo ? "Crear" : "Editar")">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Codigo" class="form-label">Código</label>
                <input asp-for="Codigo" class="form-control" readonly="@(!nuevo)" placeholder="Ej. BRK-1X20" />
                <span asp-validation-for="Codigo" class="field-validation-error"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Categoria" class="form-label">Categoría</label>
                <select asp-for="Categoria" class="form-select">
                    @foreach (var cat in InventarioService.Categorias) { <option value="@cat">@cat</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="PrecioUnitario" class="form-label">Precio unitario (COP)</label>
                <input asp-for="PrecioUnitario" type="number" step="1" class="form-control" />
                <span asp-validation-for="PrecioUnitario" class="field-validation-error"></span>
            </div>
            @if (nuevo)
            {
                <div class="col-md-6">
                    <label asp-for="Stock" class="form-label">Stock inicial</label>
                    <input asp-for="Stock" type="number" class="form-control" />
                    <span asp-validation-for="Stock" class="field-validation-error"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Codigo" />
                <div class="col-md-6">
                    <label class="form-label">Stock actual</label>
                    <input value="@Model.Stock" class="form-control" readonly />
                    <small class="text-secondary">El stock solo cambia con entradas y retiros</small>
                </div>
            }
            <div class="col-md-6">
                <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
                <input asp-for="StockMinimo" type="number" class="form-control" />
                <span asp-validation-for="StockMinimo" class="field-validation-error"></span>
                <small class="text-secondary">En ese nivel o por debajo, el producto entra en stock crítico</small>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-kubo"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
